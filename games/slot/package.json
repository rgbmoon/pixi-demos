{
  "name": "@pixi-demos/slot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint --quiet --fix .",
    "lint:ci": "eslint --quiet .",
    "typecheck": "tsc -b",
