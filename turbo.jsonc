{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["CI", "GITHUB_*", "PLAYWRIGHT_*"],
  "tasks": {
    // Задача без скрипта: её хэш складывается из исходников пакета и хэшей transit его зависимостей.
    // Задачи с зависимостью от transit получают новый хэш при правке src пакета или любой его
    // зависимости. Тесты и e2e пакета в этот хэш не входят
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!e2e/**", "!vitest.config.ts", "!playwright.config.ts"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "lint:ci": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts", "$TURBO_ROOT$/.env"]
    },
    "coverage": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts", "$TURBO_ROOT$/.env"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts", "$TURBO_ROOT$/.env"],
      "outputs": ["dist/**"]
    },
    "build:mocks": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts", "$TURBO_ROOT$/.env"],
      "outputs": ["dist/**"]
    },
    // В графе e2e не зависит от build:mocks: хэш сборки меняется при правке любой игры. Сборку
    // запускает `pnpm e2e` перед этой задачей
    "e2e": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/playwright.shared.ts", "$TURBO_ROOT$/pnpm-lock.yaml", "$TURBO_ROOT$/.env"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
